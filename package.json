{
  "name": "escaneando-reader",
  "version": "3.0.0",
  "description": "Escaneando Reader - 26 Features de Produtividade Pessoal com Privacidade Local",
  "main": "dist/main.js",
  "homepage": "./",
  "author": "Escaneando",
  "license": "MIT",
  "scripts": {
    "convert-icon": "node convert-icon.js",
    "dev": "concurrently \"npm run electron-dev\" \"npm run react-dev\"",
    "react-dev": "react-scripts start",
    "react-build": "react-scripts build",
    "electron-dev": "wait-on http://localhost:3000 && electron .",
    "electron-build": "tsc --project tsconfig.electron.json && webpack --mode production",
    "build": "npm run react-build && npm run electron-build && electron-builder",
    "dist": "npm run build",
    "full-build": "npm run convert-icon && npm run build && npm run dist",
    "eject": "react-scripts eject",
    "lint": "eslint \"src\" --ext .ts,.tsx,.js,.jsx --max-warnings=0",
    "lint:fix": "eslint \"src\" --ext .ts,.tsx,.js,.jsx --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "crypto-js": "^4.1.0",
    "pdfjs-dist": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.0",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^9.0.0",
    "jsdom": "^22.1.0",
    "png-to-ico": "^1.0.0",
    "prettier": "^2.8.8",
    "react-scripts": "5.0.1",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.4.0",
    "typescript": "^5.1.0",
    "vitest": "^1.3.4",
    "wait-on": "^7.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.escaneando.reader",
    "productName": "Escaneando Reader",
    "files": [
      "dist/**/*",
      "build/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "assets/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Escaneando Reader",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    }
  }
}
